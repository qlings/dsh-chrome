{
  "manifest_version": 3,
  "name": "DSH Chrome 桥",
  "version": "1.19.0",
  "description": "让 DeepSeek Harness（诺诺）接管本机 Chrome：读取、修改、提交当前页面，多标签跳转关联检查，复用已登录账户自动登录，幂等勾选与长文本读取。",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage",
    "alarms",
    "windows",
    "webNavigation",
    "cookies",
    "history",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["probe.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DSH Chrome 桥"
  }
}
